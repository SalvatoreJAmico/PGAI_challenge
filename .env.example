# Copy this file to .env.local for local development.
# Keep every value in this committed template empty. Never commit real secrets.

# LiveKit Cloud connection. LiveKit injects these automatically in hosted agents;
# set them locally when running the Python agent from this workspace.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ID of the configured LiveKit outbound SIP trunk.
LIVEKIT_SIP_OUTBOUND_TRUNK=

# OpenAI Realtime access and selected model name.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=

# Twilio access for recording retrieval, call metadata, and usage records.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# The one Twilio-owned E.164 caller number used for every assessment call.
TWILIO_FROM_NUMBER=

# Safety controls. The destination must be the approved PGAI assessment number;
# the application will eventually validate it against a hard-coded allowlist.
PGAI_DESTINATION_NUMBER=
MAX_CALL_SECONDS=
